--!nonstrict
-- main.luau: Background service for Saved Desktop Widgets

local saveWidgets = noctalia.getConfig("saveWidgets")
if saveWidgets == nil then saveWidgets = true end

local loadWidgets = noctalia.getConfig("loadWidgets")
if loadWidgets == nil then loadWidgets = true end

local monitorWidgets = noctalia.state.get("monitorWidgets") or {}

noctalia.state.watch("saveWidgets", function(value) saveWidgets = value end)
noctalia.state.watch("loadWidgets", function(value) loadWidgets = value end)
noctalia.state.watch("monitorWidgets", function(value) monitorWidgets = value end)

local function generateTomlForWidgets(widgetTable)
  local tomlString = "# Auto-generated by Saved Desktop Widgets Plugin\n\n"
  if type(widgetTable) ~= "table" then return tomlString end

  -- 1. Write the root properties and the mandatory widget_order array
  tomlString = tomlString .. "[desktop_widgets]\n"
  if type(widgetTable.widget_order) == "table" then
    tomlString = tomlString .. "widget_order = [\n"
    for _, id in ipairs(widgetTable.widget_order) do
      tomlString = tomlString .. string.format('  "%s",\n', id)
    end
    tomlString = tomlString .. "]\n"
  end
  if widgetTable.enabled ~= nil then
    tomlString = tomlString .. string.format("enabled = %s\n", tostring(widgetTable.enabled))
  end
  tomlString = tomlString .. "\n"

  -- 2. Write the nested widgets and their settings
  if type(widgetTable.widget) == "table" then
    for widgetId, widgetData in pairs(widgetTable.widget) do
      tomlString = tomlString .. string.format('[desktop_widgets.widget."%s"]\n', widgetId)
      for key, value in pairs(widgetData) do
        if type(value) == "string" then
          tomlString = tomlString .. string.format('%s = "%s"\n', key, value)
        elseif type(value) == "boolean" then
          tomlString = tomlString .. string.format('%s = %s\n', key, tostring(value))
        elseif type(value) == "number" then
          tomlString = tomlString .. string.format('%s = %s\n', key, value)
        end
      end
      tomlString = tomlString .. "\n"
      
      if type(widgetData.settings) == "table" then
        tomlString = tomlString .. string.format('[desktop_widgets.widget."%s".settings]\n', widgetId)
        for key, value in pairs(widgetData.settings) do
          if type(value) == "string" then
            tomlString = tomlString .. string.format('%s = "%s"\n', key, value)
          elseif type(value) == "boolean" then
            tomlString = tomlString .. string.format('%s = %s\n', key, tostring(value))
          elseif type(value) == "number" then
            tomlString = tomlString .. string.format('%s = %s\n', key, value)
          end
        end
        tomlString = tomlString .. "\n"
      end
    end
  end
  
  return tomlString
end

local function injectLayoutIntoStateFile(tomlContent)
  local statePath = noctalia.expandPath("~/.local/state/noctalia/settings.toml")
  local existingState = ""
  local contents = noctalia.readFile(statePath)
  
  if contents then
    local inDesktopWidgets = false
    -- Loop line by line to strip out the old sticky [desktop_widgets] configuration
    for line in string.gmatch(contents, "[^\r\n]+") do
      if string.match(line, "^%[desktop_widgets") then
        inDesktopWidgets = true
      elseif string.match(line, "^%[") then
        inDesktopWidgets = false
      end
      
      if not inDesktopWidgets then
        existingState = existingState .. line .. "\n"
      end
    end
  end
  
  -- Append our new layout to the cleaned state file
  local newState = existingState .. "\n" .. tomlContent
  noctalia.mkdirAll(noctalia.expandPath("~/.local/state/noctalia"))
  return noctalia.writeFile(statePath, newState)
end

local lastWallpaper = ""
local lastLayoutStr = ""
local initialized = false

noctalia.setUpdateInterval(1000)

function update()
  local output = noctalia.focusedOutputName()
  if not output then
    local outputs = noctalia.outputs()
    if outputs and #outputs > 0 then
      output = outputs[1].name
    else return end
  end
  
  local currentWallpaper = noctalia.wallpaperPath(output)
  if not currentWallpaper then return end

  -- We now know exactly which key works!
  local currentLayout = noctalia.getSetting("desktop_widgets")
  local currentLayoutStr = noctalia.json.encode(currentLayout) or ""

  -- Dump the exact data to your Desktop every second
  noctalia.writeFile(noctalia.expandPath("~/Belgeler/widget-debug.json"), currentLayoutStr)

  -- Initialize baseline on first tick to prevent instant false-positive saves
  if not initialized then
    lastWallpaper = currentWallpaper
    lastLayoutStr = currentLayoutStr
    initialized = true
    return
  end

  -- 1. Handle Wallpaper Changes
  if currentWallpaper ~= lastWallpaper then
    if loadWidgets and monitorWidgets[currentWallpaper] then
      noctalia.notify("Widget Saver", "Applying saved layout for this wallpaper...")
      local tomlContent = generateTomlForWidgets(monitorWidgets[currentWallpaper])
      
      local success, err = injectLayoutIntoStateFile(tomlContent)
      if success then
        noctalia.notify("Widget Saver", "Layout applied successfully! Reloading...")
        noctalia.runAsync({"noctalia", "msg", "config-reload"})
      else
        noctalia.notify("Error", "Failed to inject state: " .. tostring(err))
      end
    else
      noctalia.notify("Widget Saver", "No saved layout for this wallpaper.")
    end
    
    lastWallpaper = currentWallpaper
    lastLayoutStr = currentLayoutStr
    return 
  end

  -- 2. Handle Widget Layout Changes
  if saveWidgets and currentLayoutStr ~= lastLayoutStr then
    noctalia.notify("Widget Saver", "Layout change detected and saved.")
    monitorWidgets[currentWallpaper] = currentLayout
    noctalia.state.set("monitorWidgets", monitorWidgets)
    
    local dataDir = noctalia.pluginDataDir()
    if dataDir then
      local jsonStr = noctalia.json.encode(monitorWidgets)
      noctalia.writeFile(dataDir .. "/layouts.json", jsonStr or "{}")
    end
    
    lastLayoutStr = currentLayoutStr
  end
end